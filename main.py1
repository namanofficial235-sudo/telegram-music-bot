import os
from telegram import Update
from telegram.ext import Application, CommandHandler, ContextTypes
from yt_dlp import YoutubeDL

TOKEN = os.environ["BOT_TOKEN"]


async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text(
        "🎵 Music Bot online!\n\n"
        "Use /play <song name>"
    )


async def help_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text(
        "🎶 Commands:\n"
        "/play <song> - YouTube se song search\n"
        "/start - Start bot\n"
        "/help - Help"
    )


async def play(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not context.args:
        await update.message.reply_text(
            "❌ Song ka naam likho.\nExample: /play Arijit Singh"
        )
        return

    query = " ".join(context.args)

    msg = await update.message.reply_text(
        f"🔎 YouTube par searching: {query}..."
    )

    try:
        options = {
            "quiet": True,
            "no_warnings": True,
            "extract_flat": True,
            "default_search": "ytsearch1",
        }

        with YoutubeDL(options) as ydl:
            info = ydl.extract_info(query, download=False)

        entries = info.get("entries", [])

        if not entries:
            await msg.edit_text("❌ Song nahi mila.")
            return

        video = entries[0]
        title = video.get("title", "Unknown")
        webpage_url = video.get("webpage_url")

        await msg.edit_text(
            f"🎵 Found:\n\n"
            f"{title}\n\n"
            f"🔗 {webpage_url}"
        )

    except Exception as e:
        await msg.edit_text("❌ YouTube search mein error aa gaya.")
        print("ERROR:", e)


app = Application.builder().token(TOKEN).build()

app.add_handler(CommandHandler("start", start))
app.add_handler(CommandHandler("help", help_command))
app.add_handler(CommandHandler("play", play))

print("Bot is running...")
app.run_polling()
